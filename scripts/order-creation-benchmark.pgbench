begin;

set local role authenticated;

select set_config(
  'request.jwt.claims',
  json_build_object(
    'sub',
    '65000000-0000-0000-0001-' ||
      lpad((:staff_offset + :client_id)::text, 12, '0'),
    'role',
    'authenticated'
  )::text,
  true
);

select create_order(
  '[{"menu_item_id":"65000000-0000-0000-0002-000000000001","quantity":1,"price":4.50}]'::jsonb,
  (
    '65000000-0000-0000-0001-' ||
    lpad((:staff_offset + :client_id)::text, 12, '0')
  )::uuid
);

commit;
