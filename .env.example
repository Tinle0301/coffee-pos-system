# Only for local scripts that need a URL or key. The app itself does not
# read this file; it uses backend/config.js. See docs/SETUP.md section 5.
# Copy to .env (gitignored) and fill in.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Never add the secret key (sb_secret_... or SUPABASE_SERVICE_ROLE_KEY) to
# this file or anywhere in this repo. It bypasses Row Level Security.
# See docs/SETUP.md section 6.
