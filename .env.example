# Copy this file to .env.local and fill in real values. See docs/SETUP.md.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Never add SUPABASE_SERVICE_ROLE_KEY here or anywhere in this repo.
# It bypasses Row Level Security entirely and belongs nowhere in this
# codebase — not in this file, not in a committed .env, not shipped to the
# browser. See docs/SETUP.md for details.
